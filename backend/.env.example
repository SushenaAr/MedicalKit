# Скопируйте этот файл в .env и задайте свой пароль.
# Файл .env не попадает в репозиторий.

# Подключение к PostgreSQL. Эти же переменные использует контейнер БД из docker-compose.yml
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=medicalkit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=medicalkit

# Режим отладки: выводит SQL-запросы в консоль
DEBUG=false

# Адреса frontend, которым разрешено обращаться к API (JSON-список)
CORS_ORIGINS=["http://localhost:5173"]

# Секрет для подписи JWT (не короче 32 символов). Сгенерируйте свой:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Сроки действия токенов
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# true — cookie с refresh-токеном только по HTTPS (включите в production)
REFRESH_COOKIE_SECURE=false
